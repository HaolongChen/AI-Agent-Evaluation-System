{
  "postman.settings.dotenv-detection-notification-visibility": false,
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "files.watcherExclude": {
    ".git/objects/**": true,
    ".git/subtree-cache/**": true,
    ".hg/store/**": true,
    "*/.git/objects/**": true,
    "*/.git/subtree-cache/**": true,
    "*/.hg/store/**": true,
    "local_shell/**": true,
    "dist/**": true,
    "node_modules/**": true,
    "*/build/**": true,
    ".codegraphy/**": true,
    "*/generated/**": true,
    "**/*.svg": true,
    "**/*.cjs": true,
    "**/AGENT.md": true
  }
}
