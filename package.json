{
  "name": "ai-agent-evaluation-system",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "initialize": "rm -rf node_modules dist pnpm-*.yaml && pnpm install",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run clean && tsc",
    "depgen": "dependency-cruiser --config .dependency-cruiser.cjs src --output-type dot | dot -T svg > dependency-graph.svg",
    "start": "node dist/index.js",
    "dev": "nodemon --watch 'src/**/*.ts' --exec 'tsx' src/index.ts",
    "debug": "tsx --inspect src/index.ts",
    "test:unit": "tsx ./tests/unit.test.ts",
    "test:rubric-quality": "tsx ./tests/rubric-quality.test.ts",
    "test:tooling-context": "tsx ./tests/tooling-context.test.ts",
    "test:db": "tsx ./tests/verify-patch-persistence.ts",
    "test:partial-update": "tsx ./tests/partial-update-test.ts",
    "test:jq": "tsx ./tests/jq.test.ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write . && eslint --fix && pnpm depgen && prisma format",
    "db:setup": "tsx scripts/setup-db.ts",
    "db:seed": "tsx scripts/seed-golden-set.ts",
    "db:push": "pnpm dlx prisma db push",
    "db:generate": "pnpm dlx prisma generate",
    "db:migrate": "pnpm dlx prisma migrate dev",
    "db:pull": "pnpm dlx prisma db pull",
    "db:studio": "pnpm dlx prisma studio",
    "db:reset": "pnpm dlx prisma migrate reset --force",
    "db:delete": "tsx scripts/delete-golden-sets.ts",
    "db:format": "pnpm dlx prisma format",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499",
  "devDependencies": {
