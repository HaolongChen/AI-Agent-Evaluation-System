{
  "name": "ai-agent-evaluation-system",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "initialize": "rm -rf node_modules dist pnpm-*.yaml && pnpm install",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run clean && tsc",
    "build:bundle": "pnpm run clean && tsc --emitDeclarationOnly && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --sourcemap --external:@prisma/client --external:@kubernetes/client-node",
    "start": "node dist/index.js",
    "dev": "tsx watch --ignore 'src/**/*.json' src/index.ts",
    "debug": "tsx --inspect src/index.ts",
    "mytest": "tsx ./src/deep-agents/rubricsGenerator/tools/documentationReader.ts",
    "test:unit": "tsx ./tests/unit.test.ts",
    "test:db": "tsx ./tests/verify-patch-persistence.ts",
    "test:partial-update": "tsx ./tests/partial-update-test.ts",
    "test:jq": "tsx ./tests/jq.test.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "db:setup": "tsx scripts/setup-db.ts",
    "db:seed": "tsx scripts/seed-golden-set.ts",
    "db:push": "pnpm dlx prisma db push",
    "db:generate": "pnpm dlx prisma generate",
    "db:migrate": "pnpm dlx prisma migrate dev",
    "db:pull": "pnpm dlx prisma db pull",
    "db:studio": "pnpm dlx prisma studio",
    "db:reset": "pnpm dlx prisma migrate reset --force",
    "db:delete": "tsx scripts/delete-golden-sets.ts",
    "db:format": "pnpm dlx prisma format",
    "eval": "tsx src/jobs/EvaluationJobRunner.ts",
    "codegen": "graphql-codegen --config codegen.yml"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
