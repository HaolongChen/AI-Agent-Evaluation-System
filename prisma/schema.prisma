generator client {
  provider = "prisma-client"
  output   = "../build/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CopilotType {
  dataModel
  uiBuilder
  actionflow
  logAnalyzer
  agentBuilder
}

enum SessionStatus {
  running
  completed
  failed
  pending
}

enum EvaluationStatus {
  pending
  in_progress
  completed
  failed
}

enum RubricReviewStatus {
  pending
  approved
  rejected
  modified
}

// context
model goldenSet {
  id                 Int                   @id @default(autoincrement())
  schemaExId         String                @map("project_ex_id")
  copilotType        CopilotType           @map("copilot_type")
  modelName          String                @map("model_name") // e.g., 'gpt-4', 'claude-3-opus'
  copilotInputs      goldenSet_userInput[] @relation()
  // copilotOutput      copilotOutput[]     @relation()
  // evaluationSessions evaluationSession[] @relation()
  updatedAt          DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  evaluationSessions evaluationSession[]

  @@unique([schemaExId, copilotType, modelName], map: "unique_golden_set")
}

// goldenSet - userInput: many to many

model goldenSet_userInput {
  goldenSetId Int @map("golden_set_id")
  userInputId Int @map("user_input_id")

  goldenSet     goldenSet                    @relation(fields: [goldenSetId], references: [id])
  userInput     userInput                    @relation(fields: [userInputId], references: [id])
  copilotOutput copilotInput_copilotOutput[] @relation()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([goldenSetId, userInputId], map: "idx_golden_set_user_input")
}

model userInput {
  id             Int                   @id @default(autoincrement())
  description    String?
  content        String                @map("input_content") // user input
  copilotOutputs copilotOutput[]       @relation()
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?               @map("created_by")
  copilotInputs  goldenSet_userInput[] @relation()
}

model copilotInput_copilotOutput {
  copilotInputId  Int @map("copilot_input_id")
  copilotOutputId Int @map("copilot_output_id")

  copilotInput  goldenSet_userInput @relation(fields: [copilotInputId], references: [goldenSetId, userInputId])
  copilotOutput copilotOutput       @relation(fields: [copilotOutputId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([copilotInputId, copilotOutputId], map: "idx_copilot_input_output")
}

model copilotOutput {
  id        Int      @id @default(autoincrement())
  content   String   @map("output_content") // copilot output
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Performance Metrics
  totalLatencyMs    Int?     @map("total_latency_ms")
  roundtripCount    Int?     @map("roundtrip_count")
  inputTokens       Int?     @map("input_tokens")
  outputTokens      Int?     @map("output_tokens")
  totalTokens       Int?     @map("total_tokens") // input_tokens + output_tokens + reasoning tokens
  contextPercentage Decimal? @map("context_percentage") @db.Decimal(5, 2) // % of max context window used

  copilotInput copilotInput_copilotOutput[] @relation()
}

// Adaptive Rubrics (AI-generated evaluation questions - one question per row)
model questionSet {
  id Int @id @default(autoincrement())

  rubrics questionSet_adaptiveRubric[] @relation()

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
}

model questionSet_adaptiveRubric {
  questionSetId    Int @map("question_set_id")
  adaptiveRubricId Int @map("adaptive_rubric_id")

  questionSet    questionSet    @relation(fields: [questionSetId], references: [id])
  adaptiveRubric adaptiveRubric @relation(fields: [adaptiveRubricId], references: [id])

  @@id([questionSetId, adaptiveRubricId], map: "idx_question_set_adaptive_rubric")
}

model adaptiveRubric {
  id Int @id @default(autoincrement())

  // Rubric Content (one question per row)
  version        String  @default("1.0")
  title          String  @map("title")
  content        String  @map("content") @db.Text
  expectedAnswer Boolean @map("expected_answer") // perhaps could be multiple choice question
  weight         Decimal @map("weight") @db.Decimal(5, 2)

  questionSet questionSet_adaptiveRubric[] @relation()
}

// Execution Sessions (references copilot schema tables)
model evaluationSession {
  id           Int           @id @default(autoincrement())
  goldenSetId  Int           @map("golden_set_id") // Reference to golden_set.id
  modelName    String        @map("model_name") // e.g., 'gpt-4', 'claude-3-opus'
  sessionIdRef Int?          @map("session_id_ref") // Reference to copilot_session.id
  startedAt    DateTime      @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime?     @map("completed_at") @db.Timestamptz(6)
  status       SessionStatus @default(running)

  // Metadata for HITL graph execution (stores threadId, skipHumanReview, etc.)
  metadata Json?

  // Relations
  goldenSet goldenSet         @relation(fields: [goldenSetId], references: [id])
  rubrics   adaptiveRubric[]
  result    evaluationResult?

  @@index([id], map: "idx_evaluation_session_schema")
}

// Rubric Judgments (human and agent evaluations - one answer per rubric question)
model adaptiveRubricJudgeRecord {
  id        Int
  sessionId Int      @map("session_id")
  accountId String?  @map("account_id") // ID of the human judge (null for agent evaluations)
  answer    Boolean  @map("answer") // Yes/No answer to the rubric question
  comment   String?  @db.Text
  timestamp DateTime @default(now()) @map("timestamp") @db.Timestamptz(6)

  // Relations
  rubric adaptiveRubric @relation(fields: [id, sessionId], references: [id, sessionId])

  @@id([id, sessionId], map: "idx_rubric_judge_rubric")
  @@index([sessionId], map: "idx_rubric_judge_session")
}

// Evaluation Results Summary (matching LangGraph FinalReport interface)
model evaluationResult {
  id          Int         @id @default(autoincrement())
  sessionId   Int         @unique @map("session_id")
  copilotType CopilotType @map("copilot_type")
  modelName   String      @map("model_name") // e.g., 'gpt-4', 'claude-3-opus'

  evaluationStatus EvaluationStatus @default(pending) @map("evaluation_status")

  // FinalReport fields (matching LangGraph FinalReport interface)
  overallScore     Decimal  @map("overall_score") @db.Decimal(5, 2)
  summary          String   @db.Text
  detailedAnalysis String   @map("detailed_analysis") @db.Text
  auditTrace       String[] @default([]) @map("audit_trace") // Array of audit log entries
  generatedAt      DateTime @default(now()) @map("generated_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  session evaluationSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId], map: "idx_evaluation_result_lookup")
}
