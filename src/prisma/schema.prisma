generator client {
  provider = "prisma-client"
  output   = "build/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

generator erd {
  provider = "prisma-erd-generator"
}

enum AgentNameType {
  rubrics_generator_agent
  documentations_lookup_agent
  schema_lookup_agent
}

enum CopilotType {
  dataModelBuilder
  uiBuilder
  actionFlowBuilder
  logAnalyzer
  agentBuilder
}

enum EvaluatorType {
  human
  agent
}

// context
model goldenSet {
  id         String         @id @default(uuid())
  schemaId   String         @unique @map("schema_id")
  // projectExId String?               @map("project_ex_id") // corresponds to the projectExId in LangGraph
  // projectName String?               @map("project_name") // denormalized for easier querying, corresponds to the name field in project table
  // copilotType CopilotType           @default(dataModelBuilder) @map("copilot_type") // e.g., 'dataModelBuilder', 'uiBuilder', 'actionFlowBuilder', 'logAnalyzer', 'agentBuilder'
  // modelName   String                @default("undefined") @map("model_name") // e.g., 'gpt-4', 'claude-3-opus'
  userInputs copilotInput[]
  updatedAt  DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  // evaluationSessions evaluationSession[]

  // @@unique([schemaId], map: "unique_golden_set") // add copilot type
}

model project {
  id              String   @id @default(uuid())
  copilotInputId  String   @map("copilot_input_id") // corresponds to the copilotInputId in the copilotInput table for traceability
  copilotServerId String   @map("copilot_server_id") // corresponds to the copilotServerId in the copilotServer table for traceability
  projectExId     String   @map("project_ex_id")
  schemaId        String   @map("schema_id") // corresponds to the sessionId in LangGraph for traceability
  name            String   @map("name")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String   @default("unknown") @map("created_by") // userId or "system" for system-generated projects

  copilotInput   copilotInput    @relation("project_copilotInput", fields: [copilotInputId], references: [id])
  copilotServer  copilotServer   @relation(fields: [copilotServerId], references: [id])
  copilotSession copilotSession?

  @@unique([projectExId], map: "unique_project_ex_id")
  @@unique([name], map: "unique_project_name")
  @@index([copilotInputId, copilotServerId], map: "idx_project_copilot_input_server_id")
}

model userInput {
  id         String         @id @default(uuid())
  // description String?
  content    String         @map("input_content") // user input
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String         @default("unknown") @map("created_by") // userId or "auto-generated" for system-generated inputs
  goldenSets copilotInput[]
}

model copilotInput {
  id          String @id @default(uuid())
  goldenSetId String @map("golden_set_id")
  userInputId String @map("user_input_id")

  goldenSet goldenSet @relation(fields: [goldenSetId], references: [id])
  userInput userInput @relation(fields: [userInputId], references: [id])

  projects  project[] @relation("project_copilotInput")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([goldenSetId, userInputId], map: "idx_schema_user_input")
}

model copilotServer {
  id          String    @id @default(uuid())
  name        String    @map("name") // e.g., 'aws-us-east-1', 'azure-westus2'
  description String?   @map("description")
  wsEndpoint  String    @map("wsEndpoint") // e.g., 'https://zionbackend.functorz.work/api/subscription'
  gqlEndpoint String    @map("gqlEndpoint") // e.g., 'https://zionbackend.functorz.work/api/graphql'
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  project     project[]
}

model copilotSession {
  id        String  @id @default(uuid())
  projectId String  @unique @map("project_id")
  project   project @relation(fields: [projectId], references: [id])

  copilotOutput copilotOutput?
  rubric        rubric[]       @relation("copilotSession_rubric")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
}

model copilotOutput {
  id                 String         @id @default(uuid())
  copilotSession     copilotSession @relation(fields: [copilotSessionExId], references: [id])
  editableText       String?        @map("output_content") // copilot output
  aiResponse         String         @map("ai_response") // AI response
  copilotSessionExId String         @unique @map("copilot_session_id") // corresponds to the sessionId in LangGraph for traceability
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  // Performance Metrics
  // totalLatencyMs    Int?     @map("total_latency_ms")
  // roundtripCount    Int?     @map("roundtrip_count")
  // inputTokens       Int?     @map("input_tokens")
  // outputTokens      Int?     @map("output_tokens")
  // totalTokens       Int?     @map("total_tokens") // input_tokens + output_tokens + reasoning tokens
  // contextPercentage Decimal? @map("context_percentage") @db.Decimal(5, 2) // % of max context window used

  // rubrics rubric[] @relation("copilotOutput_rubric")
}

