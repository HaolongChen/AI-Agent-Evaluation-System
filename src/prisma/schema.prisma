generator client {
  provider = "prisma-client"
  output   = "build/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

generator erd {
  provider = "prisma-erd-generator"
}

enum AgentNameType {
  rubrics_generator_agent
  documentations_lookup_agent
  schema_lookup_agent
}

enum CopilotType {
  dataModelBuilder
  uiBuilder
  actionFlowBuilder
  logAnalyzer
  agentBuilder
}

enum EvaluatorType {
  human
  agent
}

// context
model goldenSet {
  id          String                @id @default(uuid())
  schemaId    String                @map("schema_id")
  projectExId String?               @map("project_ex_id") // corresponds to the projectExId in LangGraph
  copilotType CopilotType           @default(dataModelBuilder) @map("copilot_type") // e.g., 'dataModelBuilder', 'uiBuilder', 'actionFlowBuilder', 'logAnalyzer', 'agentBuilder'
  modelName   String                @default("undefined") @map("model_name") // e.g., 'gpt-4', 'claude-3-opus'
  userInputs  goldenSet_userInput[]
  updatedAt   DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  // evaluationSessions evaluationSession[]

  @@unique([schemaId, copilotType, modelName], map: "unique_golden_set")
}

model project {
  id          String   @id @default(uuid())
  projectExId String   @map("project_ex_id") // corresponds to the projectExId in LangGraph
  schemaId    String   @map("schema_id")
  name        String   @map("name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String   @default("unknown") @map("created_by") // userId or "system" for system-generated projects

  @@unique([projectExId], map: "unique_project_ex_id")
  @@unique([schemaId], map: "unique_project_schema_id")
  @@unique([name], map: "unique_project_name")
}

model userInput {
  id         String                @id @default(uuid())
  // description String?
  content    String                @map("input_content") // user input
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String                @default("unknown") @map("created_by") // userId or "auto-generated" for system-generated inputs
  goldenSets goldenSet_userInput[]
}

model goldenSet_userInput {
  goldenSetId String @map("golden_set_id")
  userInputId String @map("user_input_id")

  goldenSet     goldenSet       @relation(fields: [goldenSetId], references: [id])
  userInput     userInput       @relation(fields: [userInputId], references: [id])
  copilotOutput copilotOutput[]
  rubrics       rubric[]

  @@id([goldenSetId, userInputId], map: "idx_golden_set_user_input")
}

model copilotOutput {
  id                 String              @id @default(uuid())
  goldenSetId        String              @map("golden_set_id")
  userInputId        String              @map("user_input_id")
  copilotInput       goldenSet_userInput @relation(fields: [goldenSetId, userInputId], references: [goldenSetId, userInputId])
  editableText       String?             @map("output_content") // copilot output
  aiResponse         String              @map("ai_response") // AI response
  copilotSessionExId String              @map("copilot_session_id") // corresponds to the sessionId in LangGraph for traceability
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  // Performance Metrics
  // totalLatencyMs    Int?     @map("total_latency_ms")
  // roundtripCount    Int?     @map("roundtrip_count")
  // inputTokens       Int?     @map("input_tokens")
  // outputTokens      Int?     @map("output_tokens")
  // totalTokens       Int?     @map("total_tokens") // input_tokens + output_tokens + reasoning tokens
  // contextPercentage Decimal? @map("context_percentage") @db.Decimal(5, 2) // % of max context window used

  rubrics copilotOutput_rubric[]

  @@index([goldenSetId, userInputId], map: "idx_copilot_output_golden_user_input")
}

model copilotOutput_rubric {
  copilotOutputId String @map("copilot_output_id")
  rubricId        String @map("rubric_id")

  copilotOutput      copilotOutput       @relation(fields: [copilotOutputId], references: [id])
  rubric             rubric              @relation(fields: [rubricId], references: [id])
  evaluationSessions evaluationSession[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([copilotOutputId, rubricId], map: "idx_copilot_output_rubric")
}

// Adaptive Rubrics (AI-generated evaluation criterion - one criteria per row)
model rubric {
  id          String @id @default(uuid())
  goldenSetId String @map("golden_set_id")
  userInputId String @map("user_input_id")

  copilotInput   goldenSet_userInput    @relation(fields: [goldenSetId, userInputId], references: [goldenSetId, userInputId])
  copilotOutputs copilotOutput_rubric[]
  criterion      criteria[]
  agentFeedbacks agentFeedbacks[]

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([goldenSetId, userInputId], map: "idx_rubric_golden_user_input")
}

model criteria {
  id       String @id @default(uuid())
  rubricId String @map("rubric_id")

  // Rubric Content (one criteria per row)
  // version        String  @default("1.0")
  // title          String  @map("title")
  content        String   @map("content") @db.Text
  expectedAnswer Boolean  @map("expected_answer") // perhaps could be multiple choice criteria
  weight         Decimal  @map("weight") @db.Decimal(5, 2)
  reasoning      String?  @map("reasoning") @db.Text // optional explanation of the criterion
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rubric rubric @relation(fields: [rubricId], references: [id])

  @@unique([id, rubricId], map: "unique_criteria_per_set")
}

model agentFeedbacks {
  id        String        @id @default(uuid())
  rubricId  String        @map("rubric_id")
  agentName AgentNameType @map("agent_name")
  feedback  String[]      @map("feedback") // free-form feedback from the evaluation agent
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  rubric rubric @relation(fields: [rubricId], references: [id])

  @@index([rubricId, agentName], map: "idx_agent_feedback_scheme")
}

// Execution Sessions (references copilot schema tables)
model evaluationSession {
  id              String        @id @default(uuid())
  evaluatorType   EvaluatorType @default(human)
  copilotOutputId String        @map("copilot_output_id")
  rubricId        String        @map("rubric_id")
  evaluatorId     String        @map("evaluator_id") // could be agentId or "auto-evaluation" for agent evaluations
  modelName       String?       @map("model_name") // e.g., 'gpt-4', 'claude-3-opus' * only for evaluation agents *
  startedAt       DateTime      @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime?     @map("completed_at") @db.Timestamptz(6)
  // status          SessionStatus @default(running)

  // Metadata for HITL graph execution (stores threadId, skipHumanReview, etc.)
  metadata Json?

  // Relations
  rubric            copilotOutput_rubric @relation(fields: [copilotOutputId, rubricId], references: [copilotOutputId, rubricId])
  evaluationRecords evaluationRecord[]   @relation(map: "agent_evaluation_records")
  result            evaluationResult?    @relation(map: "agent_evaluation_result_relation")

  @@unique([evaluatorId, copilotOutputId, rubricId, evaluatorType], map: "unique_agent_evaluation_session")
  @@index([copilotOutputId, rubricId], map: "idx_evaluation_session_scheme")
}

// Rubric Judgments (human and agent evaluations - one answer per rubric criteria)
model evaluationRecord {
  id              String        @id @default(uuid())
  copilotOutputId String        @map("copilot_output_id")
  evaluatorType   EvaluatorType @map("evaluator_type") // human or agent
  rubricId        String        @map("rubric_id")
  criteriaId      String        @map("criteria_id")
  evaluatorId     String        @map("evaluator_id") // humanId for human evaluations. otherwise, could be agentId or "auto-evaluation" for agent evaluations
  evaluation      Boolean       @map("evaluator_evaluation") // perhaps could be multiple choice criteria in the future
  feedback        String?       @map("feedback") // optional free-form feedback from the evaluator
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  evaluationSession evaluationSession @relation(fields: [evaluatorId, copilotOutputId, rubricId, evaluatorType], references: [evaluatorId, copilotOutputId, rubricId, evaluatorType], map: "agent_evaluation_session_relation")

  @@unique([evaluatorId, copilotOutputId, rubricId, criteriaId], map: "unique_agent_evaluation_record")
  @@index([copilotOutputId, rubricId], map: "idx_agent_evaluation_record_scheme")
}

// Evaluation Results Summary (matching LangGraph FinalReport interface)
model evaluationResult {
  id              String        @id @default(uuid())
  evaluatorId     String        @map("evaluator_id") // humanId for human evaluations. otherwise, could be agentId or "auto-evaluation" for agent evaluations
  copilotOutputId String        @map("copilot_output_id")
  rubricId        String        @map("rubric_id")
  evaluatorType   EvaluatorType @map("evaluator_type") // human or agent

  // FinalReport fields (matching LangGraph FinalReport interface)
  overallScore Decimal  @map("overall_score") @db.Decimal(5, 2)
  analysis     String   @map("analysis") @db.Text
  auditTrace   String[] @default([]) @map("audit_trace") // Array of audit log entries
  generatedAt  DateTime @default(now()) @map("generated_at") @db.Timestamptz(6)

  // Relations
  evaluationSession evaluationSession @relation(fields: [evaluatorId, copilotOutputId, rubricId, evaluatorType], references: [evaluatorId, copilotOutputId, rubricId, evaluatorType], map: "human_evaluation_result_relation")

  @@unique([evaluatorId, copilotOutputId, rubricId, evaluatorType], map: "idx_evaluation_result_lookup")
  @@index([copilotOutputId, rubricId], map: "idx_evaluation_result_scheme")
}
