{
	"extends": "@tsconfig/node-ts/tsconfig.json",
	"compilerOptions": {
		"rootDir": "./",
		"paths": {
			"@src/*": ["./src/*"],
			"@entities/*": ["./src/entities/*"],
			"@interface/*": ["./src/interface/*"],
			"@services/*": ["./src/services/*"],
			"@graphql/*": ["./src/graphql/*"],
			"@config/*": ["./src/config/*"],
			"@db/*": ["./src/prisma/build/generated/prisma/*.ts"]
		},
		"pretty": true,
		"typeRoots": ["./node_modules/@types"],
		"erasableSyntaxOnly": false
	},
	"include": ["src", "./*.ts"]
}
